# ==============================================================================
# VEER SURVIVOR — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Security & Admin Authentication (Defaults to K0lst@rno.1)
# Set a secret admin passcode to protect Admin Command Center actions.
ADMIN_PASSWORD=K0lst@rno.1

# 2. Google Gemini AI API Keys (Optional - Free tier from aistudio.google.com)
# Unified Key (applied to Attack AI, Defence AI, and Referee AI):
GEMINI_API_KEY=

# Or separate keys for distinct AI roles:
GEMINI_API_KEY_ATTACK=
GEMINI_API_KEY_DEFENCE=
GEMINI_API_KEY_EVALUATION=

# 3. Database Path Override (Optional)
# In Vercel / serverless environments, it automatically defaults to /tmp/matches.db
# DB_PATH=/tmp/matches.db
